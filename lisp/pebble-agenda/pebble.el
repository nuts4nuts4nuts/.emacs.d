;;; pebble.el --- Native Pebble scene transport -*- lexical-binding: t; -*-
;; Version: 0.2.0
;; Package-Requires: ((emacs "28.1"))
;; Keywords: hardware, comm
;; URL: https://developer.repebble.com/
;;; Commentary:
;; Retained scenes and a small authenticated HTTP transport for Pebble apps.
;;; Code:
(require 'cl-lib)
(require 'json)
(require 'subr-x)
(require 'url-util)
(defgroup pebble nil "Native Pebble user interfaces." :group 'applications)
(defcustom pebble-http-host "127.0.0.1" "Address to bind; loopback by default." :type 'string)
(defcustom pebble-http-port 8765 "HTTP listening port." :type 'integer)
(defvar pebble-auth-token nil "Bearer token; nil permits unauthenticated demo use.")
(defconst pebble--library-directory (file-name-directory (or load-file-name buffer-file-name)))
(defvar pebble--session (format "%s-%s" (emacs-pid) (float-time)))
(defvar pebble--event-context nil)
(defvar pebble--receipts (make-hash-table :test 'equal))
(define-error 'pebble-unauthorized "Pairing token required")
(define-error 'pebble-stale-event "Screen changed; try again")
(defun pebble-new-session ()
  "Invalidate phone revisions and old event receipts."
  (setq pebble--session (format "%s-%s" (emacs-pid) (float-time))
        pebble--receipts (make-hash-table :test 'equal)))
(defvar pebble--elements nil)
(defvar pebble--revision 0)
(defvar pebble--published-ms 0)
(defvar pebble--last-message nil)
(defvar pebble--server nil)
(defvar pebble-runtime-javascript nil
  "Optional explicitly supplied phone runtime source; nil disables loading.")
(defvar pebble--handlers (make-hash-table :test 'equal))
(defun pebble--validate (elements)
  "Validate scene ELEMENTS before publishing."
  (unless (and (vectorp elements) (<= (length elements) 128)) (error "Invalid elements"))
  (let ((ids nil))
    (mapc (lambda (e)
            (let ((id (plist-get e :id)) (type (plist-get e :type)))
              (unless (and (integerp id) (< 0 id 65536) (not (memq id ids))) (error "Invalid/duplicate ID"))
              (push id ids)
              (unless (member type '("text" "fill" "rect" "line" "clip")) (error "Invalid type"))
              (dolist (key '(:x :y :width :height))
                (let ((v (or (plist-get e key) 0)))
                  (unless (and (integerp v) (<= (if (memq key '(:x :y)) -32768 0) v 32767)) (error "Invalid geometry"))))
              (when (or (> (+ (or (plist-get e :x) 0) (or (plist-get e :width) 0)) 32767) (> (+ (or (plist-get e :y) 0) (or (plist-get e :height) 0)) 32767)) (error "Geometry extent overflow"))
              (unless (<= (string-bytes (or (plist-get e :value) "")) 63) (error "Text too long"))
              (let ((c (or (plist-get e :color) 192))) (unless (and (integerp c) (<= 192 c 255)) (error "Invalid color"))))) elements)))
(defun pebble-show (screen)
  "Publish SCREEN plist containing a :children vector."
  (let ((es (plist-get screen :children))) (pebble--validate es) (setq pebble--elements (copy-tree es t)) (setq pebble--published-ms (floor (* 1000 (float-time)))) (setq pebble--last-message (list :op "set_scene" :elements pebble--elements)) (cl-incf pebble--revision)))
(defun pebble-update (id properties)
  "Merge PROPERTIES into existing element ID and publish."
  (let* ((es (copy-tree pebble--elements t)) (e (cl-find id es :key (lambda (e) (plist-get e :id)))))
    (unless e (error "Unknown element"))
    (when (and (plist-member properties :id) (/= id (plist-get properties :id))) (error "Cannot change ID"))
    (while properties (setq e (plist-put e (pop properties) (pop properties))))
    (dotimes (i (length es)) (when (= id (plist-get (aref es i) :id)) (aset es i e)))
    (pebble-show (list :children es))
    (setq pebble--last-message (list :op "update" :elements (vector e)))))
(defun pebble-create (element)
  (pebble-show (list :children (vconcat pebble--elements (vector element))))
  (setq pebble--last-message (list :op "create" :elements (vector element))))
(defun pebble-delete (id)
  (unless (cl-find id pebble--elements :key (lambda (e) (plist-get e :id))) (error "Unknown element"))
  (pebble-show (list :children (vconcat (cl-remove id (append pebble--elements nil) :key (lambda (e) (plist-get e :id))))))
  (setq pebble--last-message (list :op "delete" :elements (vector (list :id id)))))
(defun pebble-on (type handler) (puthash type handler pebble--handlers))
(defun pebble-dispatch (method path body &optional authorization)
  "Return response plist for a limited HTTP route; never evaluate Lisp."
  (unless (or (and (equal method "GET") (equal path "/configure"))
              (null pebble-auth-token)
              (equal authorization (concat "Bearer " pebble-auth-token)))
    (signal 'pebble-unauthorized nil))
  (cond
   ((and (equal method "GET") (equal path "/configure"))
    (with-temp-buffer
      (insert-file-contents (expand-file-name "pebble-config.html" pebble--library-directory))
      (buffer-string)))
   ((and (equal method "GET") (equal path "/runtime.js") (stringp pebble-runtime-javascript)) pebble-runtime-javascript)
   ((and (equal method "GET") (string-match-p "\\`/scene\\(?:?\\|\\'\\)" path))
    (let ((since (if (string-match "[?]since=\\([0-9]+\\)\\'" path) (string-to-number (match-string 1 path)) -1)))
      (list :revision pebble--revision :published_ms pebble--published-ms :session pebble--session :message (if (and (= since (1- pebble--revision)) pebble--last-message) pebble--last-message (list :op "set_scene" :elements (or pebble--elements []))))))
   ((and (equal method "POST") (equal path "/event"))
    (let* ((event (json-parse-string body :object-type 'plist))
           (type (plist-get event :type)) (id (plist-get event :id))
           (handler (gethash type pebble--handlers))
           (event-id (plist-get event :event_id))
           (receipt (and event-id (gethash event-id pebble--receipts))))
      (unless (and (member type '("select" "back")) (integerp id) (<= 0 id 65535)
                   (or (null event-id) (and (stringp event-id) (<= (length event-id) 100))))
        (error "Invalid event"))
      (if receipt
          (if (equal (car receipt) event) (cdr receipt)
            (signal 'pebble-stale-event nil))
        (unless handler (error "Unhandled event"))
        (let ((pebble--event-context event)) (funcall handler id))
        (let ((result (list :ok t)))
          (when event-id
            (when (>= (hash-table-count pebble--receipts) 128) (clrhash pebble--receipts))
            (puthash event-id (cons event result) pebble--receipts))
          result))))
   (t (error "Unknown route"))))
(defun pebble--reply (client status object)
  (let ((body (encode-coding-string (if (stringp object) object (json-serialize object)) 'utf-8)))
    (process-send-string client (format "HTTP/1.1 %s\r\nContent-Type: %s\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s" status (if (stringp object) (if (string-prefix-p "<!doctype html>" object) "text/html; charset=utf-8" "application/javascript") "application/json") (length body) body))
    (delete-process client)))
(defun pebble--filter (client bytes)
  (condition-case err
      (let ((data (concat (process-get client 'request) bytes)))
        (when (> (length data) 32768) (error "Request too large"))
        (process-put client 'request data)
        (when (string-match "\r\n\r\n" data)
          (let* ((end (match-end 0)) (header (substring data 0 end))
                 (len (if (string-match "[Cc]ontent-[Ll]ength: *\\([0-9]+\\)" header) (string-to-number (match-string 1 header)) 0)))
            (when (> len 16384) (error "Body too large"))
            (when (>= (length data) (+ end len))
              (unless (string-match "\\`\\(GET\\|POST\\) \\([^ ]+\\) HTTP/1\\.[01]\r\n" header) (error "Invalid HTTP request"))
              (let ((method (match-string 1 header)) (path (match-string 2 header))
                    (authorization (let ((case-fold-search t))
                                     (when (string-match "\r\nAuthorization: *\\([^\r\n]+\\)" header)
                                       (string-trim (match-string 1 header))))))
                (pebble--reply client "200 OK" (pebble-dispatch method path (decode-coding-string (substring data end (+ end len)) 'utf-8) authorization)))))))
    (pebble-unauthorized (when (process-live-p client) (pebble--reply client "401 Unauthorized" (list :error "Pairing token required"))))
    (pebble-stale-event (when (process-live-p client) (pebble--reply client "409 Conflict" (list :error "Screen changed; try again"))))
    (error (when (process-live-p client) (pebble--reply client "400 Bad Request" (list :error (error-message-string err)))))))
(defun pebble-start (&optional port)
  "Start the HTTP server on PORT, using `pebble-http-host'."
  (unless (or (member pebble-http-host '("127.0.0.1" "localhost" "::1")) pebble-auth-token)
    (error "A token is required for non-loopback listeners"))
  (pebble-stop)
  (setq pebble--server (make-network-process :name "pebble-http" :server t :host pebble-http-host :service (or port pebble-http-port) :family 'ipv4 :coding 'binary :noquery t :filter #'pebble--filter)))
(defun pebble-stop () (when (process-live-p pebble--server) (delete-process pebble--server)) (setq pebble--server nil))
(provide 'pebble)
